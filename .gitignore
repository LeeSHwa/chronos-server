# ─────────────────────────────────────────────
# 빌드 산출물 (Gradle / Java)
# ─────────────────────────────────────────────
server/build/
server/out/
server/.gradle/
server/bin/
# server/gradle/wrapper/gradle-wrapper.jar 는 반드시 커밋할 것.
# 이게 없으면 clone 받은 쪽에서 ./gradlew 가 동작하지 않는다.

# ─────────────────────────────────────────────
# IDE
# ─────────────────────────────────────────────
.idea/
*.iml
*.iws
*.ipr

# ─────────────────────────────────────────────
# Docker 이미지 아카이브
# docker save 로 만든 tar 는 수백 MB라 절대 커밋하지 말 것.
# GitHub 은 파일당 100MB 제한이 있고, 한 번 들어가면 히스토리에서 지우기 어렵다.
# ─────────────────────────────────────────────
*.tar
*.tar.gz

# ─────────────────────────────────────────────
# 비밀 정보
# SSH 키, 인증서, 환경변수 파일은 절대 올리지 않는다.
# DB 비밀번호는 application.yml 에서 이미 제거했고 환경변수로 주입된다.
# ─────────────────────────────────────────────
*.key
*.pem
*.p12
.env
.env.*
!.env.example

# ─────────────────────────────────────────────
# DB 백업 / 로그
# ─────────────────────────────────────────────
*.sql.gz
backup*.sql
*.log
pending_logs.ndjson

# ─────────────────────────────────────────────
# OS
# ─────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─────────────────────────────────────────────
# Claude Code 로컬 설정 (개인 설정이라 공유하지 않음)
# ─────────────────────────────────────────────
.claude/settings.local.json
